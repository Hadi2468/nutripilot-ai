# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- LLM provider ----------------------------------------------------
# Default provider: groq, openai or anthropic. Clients (the dashboard model picker, the CLI's
# --provider/--model) can choose any catalog model whose provider has a key below.
NUTRIPILOT_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Empty = the provider's default: openai/gpt-oss-20b, gpt-4o-mini or claude-opus-5-5
NUTRIPILOT_MODEL=
# Groq / OpenAI sampling temperature
NUTRIPILOT_TEMPERATURE=0.3
# Claude thinking depth: low, medium, high, xhigh or max
NUTRIPILOT_CLAUDE_EFFORT=medium

# --- Output validation -----------------------------------------------
# Extra LLM calls allowed to fix an answer that failed a check
NUTRIPILOT_MAX_REPAIRS=1
# Allowed daily calorie error (0.10 = 10%)
NUTRIPILOT_CALORIE_TOLERANCE=0.10

# --- API -------------------------------------------------------------
# When set, requests need "Authorization: Bearer <token>" (the old API_TOKEN name also works)
NUTRIPILOT_API_TOKEN=
# Where the Streamlit dashboard finds the API (local, Docker, or the SAM ApiUrl output)
NUTRIPILOT_API_URL=http://localhost:8000
